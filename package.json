{
  "name": "arios-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent Persian ARIOS project operations and customer portal",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "demo": "ARIOS_DEMO=1 node --env-file-if-exists=.env server.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "package:source": "node scripts/package-source.mjs"
  }
}
