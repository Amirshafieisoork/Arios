{
  "name": "arios-os",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Independent Persian ARIOS project operations and customer portal",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "demo": "ARIOS_DEMO=1 node --env-file-if-exists=.env server.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "package:source": "node scripts/package-source.mjs",
    "db:generate": "drizzle-kit generate",
    "build": "node scripts/build-hosted.mjs",
    "package:hosted": "node scripts/package-hosted.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "build:public-site": "npm run build:vercel && node scripts/build-public-site.mjs"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2"
  }
}
