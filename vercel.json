{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist-site",
  "installCommand": "npm ci",
  "framework": null,
  "functions": { "api/index.mjs": { "maxDuration": 180 } },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "arios-rouge.vercel.app" }],
      "destination": "https://arioshub.ir/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?route=:path*" },
    { "source": "/login/client", "destination": "/login.html" },
    { "source": "/login/team", "destination": "/login.html" },
    { "source": "/setup", "destination": "/setup.html" }
  ],
  "headers": [{ "source": "/downloads/arios-android.apk", "headers": [
    { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
    { "key": "Content-Disposition", "value": "attachment; filename=arios-android.apk" },
    { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
  ]}, { "source": "/downloads/arios-android-release.json", "headers": [
    { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
  ]}, { "source": "/downloads/arios-android.apk.sha256", "headers": [
    { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
  ]}, { "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
    { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://qategfabulrkvdckzmqp.supabase.co; connect-src 'self' https://qategfabulrkvdckzmqp.supabase.co; media-src 'self' blob: https://qategfabulrkvdckzmqp.supabase.co; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" }
  ]}]
}
