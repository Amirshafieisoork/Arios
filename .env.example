# ARIOS v0.3 — dedicated resources only. Never reuse Doctor Man or unrelated credentials.
# This file is an example. Do not commit real passwords, tokens, service keys or runtime data.

# CURRENT BFF — Vercel Function or the public Sites fallback Worker
# Configure these in the server runtime, not browser JavaScript.
# Only the dedicated ARIOS Supabase project is allowed here.
ARIOS_SUPABASE_URL=https://qategfabulrkvdckzmqp.supabase.co
ARIOS_SUPABASE_PUBLISHABLE_KEY=

# SUPABASE EDGE FUNCTION arios-api
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied automatically by that
# dedicated Supabase project's Edge runtime. Do not copy the service-role key
# into this file, Vercel, BFF runtime, browser code, source archives or logs.
# Telegram/AI credentials are configured through the authenticated manager form
# and stored in private service-only settings; no real credentials belong here.
# Owner bootstrap uses a separately delivered one-time fragment link, not a source secret.
# There is no permanent webhook, background scheduler or anonymous sync endpoint.

# LEGACY STANDALONE NODE SERVER ONLY (SQLite + its own password sessions)
# npm start loads local .env via --env-file-if-exists. This is not the current Supabase BFF.
# Export explicitly when launching node server.mjs without --env-file.
# ARIOS_HOST=127.0.0.1
# ARIOS_PORT=3000
# ARIOS_DB_PATH=./data/arios.sqlite
# Required only for first legacy production Node start; remove bootstrap password afterwards.
# ARIOS_BOOTSTRAP_EMAIL=manager@example.com
# ARIOS_BOOTSTRAP_PASSWORD=
# Remote legacy Node requires HTTPS and an exact origin; local HTTP is allowed.
# ARIOS_PUBLIC_ORIGIN=https://arios.example.com
# ARIOS_DEMO=1
# Optional dedicated provider for the legacy Node assistant only:
# ARIOS_AI_BASE_URL=https://api.avalai.ir/v1
# ARIOS_AI_API_KEY=
# ARIOS_AI_MODEL=gpt-4o-mini
# Old D1 owner/encryption variables are not required by the v0.3 BFF.
# Payments remain disabled until a separately verified gateway integration exists.
