# ARIOS owns its credentials and database. Existing or unrelated injected variables are never used.
# Node does not load this file automatically; export these explicitly, or use node --env-file=.env server.mjs.
ARIOS_HOST=127.0.0.1
ARIOS_PORT=3000
ARIOS_DB_PATH=./data/arios.sqlite
# Required ONLY for the first production start; remove password after successful bootstrap.
ARIOS_BOOTSTRAP_EMAIL=manager@example.com
ARIOS_BOOTSTRAP_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# Remote production requires HTTPS and an exact origin; local HTTP is allowed.
# ARIOS_PUBLIC_ORIGIN=https://arios.example.com
# Explicit localhost-only fictional demo: npm run demo (separate arios-demo.sqlite).
# ARIOS_DEMO=1
# Optional independent OpenAI-compatible provider; set ALL THREE dedicated settings.
# ARIOS_AI_BASE_URL=https://your-dedicated-provider.example/v1
# ARIOS_AI_API_KEY=
# ARIOS_AI_MODEL=
# Payments intentionally disabled until a separately verified gateway integration exists.
