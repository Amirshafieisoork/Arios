# ARIOS owns its credentials, data, dependency directory, and services.
# Never reuse Doctor Man or unrelated injected settings. Never commit real values.
# This file is a template, not a credential file. Only ARIOS_* application variables are used.

# HOSTED SITES WORKER
# Set these through Sites runtime environment tools; .env is not uploaded automatically.
# Required for first owner bootstrap (ChatGPT email); example deliberately contains no real address.
# ARIOS_OWNER_EMAIL=owner@example.com
# Required secret for encrypted manager settings: Base64 of exactly 32 random bytes.
# Preserve this secret across deployments; unplanned rotation makes old settings unreadable.
# ARIOS_ENCRYPTION_KEY=

# Optional hosted overrides. Otherwise configure dedicated provider/bot values in the manager UI.
# Runtime overrides take precedence over encrypted form settings.
# Only these two hosted provider origins are accepted:
# ARIOS_AI_BASE_URL=https://api.avalai.ir/v1
# ARIOS_AI_API_KEY=
# ARIOS_AI_MODEL=gpt-4o-mini
# ARIOS_TRANSCRIPTION_MODEL=whisper-1
# ARIOS_TELEGRAM_BOT_TOKEN=

# Optional unattended sync; use ONLY behind the verified owner-private Sites access boundary.
# Requires a service caller authorized by Sites, with no browser identity or Origin header.
# This enables an endpoint, not a schedule. Do not put secrets into task prompts.
# Disable before making the site public or broadening its audience without an access review.
# ARIOS_PRIVATE_SERVICE_SYNC=1

# STANDALONE NODE SERVER (SQLite + password sessions; hosted voice APIs are not served here)
# npm start loads this local file via node --env-file-if-exists=.env.
# Export explicitly if launching node server.mjs directly without --env-file.
ARIOS_HOST=127.0.0.1
ARIOS_PORT=3000
ARIOS_DB_PATH=./data/arios.sqlite
# Required ONLY for first production Node start; remove bootstrap password afterwards.
ARIOS_BOOTSTRAP_EMAIL=manager@example.com
ARIOS_BOOTSTRAP_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# Remote production requires HTTPS and an exact origin; local HTTP is allowed.
# ARIOS_PUBLIC_ORIGIN=https://arios.example.com
# Explicit localhost-only fictional demo: npm run demo (separate arios-demo.sqlite).
# ARIOS_DEMO=1
# The same dedicated ARIOS_AI_BASE_URL/API_KEY/MODEL names configure the Node assistant.
# Node does not read hosted owner/encryption/Telegram/service-sync variables.
# Payments remain disabled until a separately verified gateway integration exists.
